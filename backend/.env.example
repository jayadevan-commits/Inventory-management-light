# Copy this file to ".env" and fill in your own values. Never commit ".env".

# --- MySQL connection ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inventory_db
DB_POOL_SIZE=10

# true  = create the database and tables on startup (existing data is never touched)
# false = you import schema.sql yourself in MySQL Workbench
AUTO_INIT_SCHEMA=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- CORS: comma-separated list of frontend URLs allowed to call the API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
